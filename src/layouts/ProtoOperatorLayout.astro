---
import { person } from '../data/proto-content';
interface Props { title: string; section?: 'Home' | 'Projects' }
const { title, section = 'Home' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | wadakatu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=M+PLUS+1+Code:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/proto/operator.css" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('proto-operator-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top frame">
      <a class="mark" href="/proto/operator/">wadakatu / operator</a>
      <nav aria-label="Main navigation">
        <a href="/proto/operator/" aria-current={section === 'Home' ? 'page' : undefined}>Home</a>
        <a href="/proto/operator/projects/" aria-current={section === 'Projects' ? 'page' : undefined}>Projects</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </nav>
      <!-- A checkbox, so the streams can be stopped without JavaScript. -->
      <label class="control hold"><input type="checkbox" id="hold" /> Hold streams</label>
      <button id="theme" class="control" type="button" hidden>
        <span class="to-night">Night shift</span><span class="to-day">Day shift</span>
      </button>
    </header>
    <main id="main" class="frame"><slot /></main>
    <footer class="foot frame">
      <a href={`mailto:${person.email}`}>{person.email}</a>
      <a href={person.github}>GitHub</a>
      <a href={person.x}>X {person.xHandle}</a>
      <a href={person.logoCreditUrl}>{person.logoCredit}</a>
      <a class="back" href="/proto/">All explorations</a>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const theme = document.getElementById('theme');
      theme.hidden = false;
      theme.addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('proto-operator-theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
