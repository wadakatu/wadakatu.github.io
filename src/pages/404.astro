---
// 404 Page
import SkipLink from '@components/SkipLink.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
    (() => { const t = localStorage.getItem('tombo-theme');
      if (t === 'tombo' || t === 'hotaru') document.documentElement.dataset.theme = t; })();
  </script>
  <meta charset="UTF-8">
  <!-- Note: frame-ancestors CSP directive only works via HTTP header, not meta tag -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; base-uri 'self'; form-action 'self';">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | wadakatu</title>
  <meta name="description" content="No route matches this path. Head back to the index.">
  <meta name="robots" content="noindex">

  <!-- OGP -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.wadakatu.dev/404">
  <meta property="og:title" content="404 - Page Not Found | wadakatu">
  <meta property="og:description" content="No route matches this path. Head back to the index.">
  <meta property="og:image" content="https://www.wadakatu.dev/ogp.webp">
  <meta property="og:image:alt" content="wadakatu - Backend Developer portfolio preview">
  <meta property="og:site_name" content="wadakatu">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@koyolympus">
  <meta name="twitter:title" content="404 - Page Not Found | wadakatu">
  <meta name="twitter:description" content="No route matches this path. Head back to the index.">
  <meta name="twitter:image" content="https://www.wadakatu.dev/ogp.webp">

  <!-- Theme Color -->
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F2F4EF" data-tombo="#F2F4EF" data-hotaru="#131714">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131714" data-tombo="#F2F4EF" data-hotaru="#131714">

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">

  <!-- Google Fonts (Non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@600;700&family=M+PLUS+2:wght@450;500;700&family=Martian+Mono:wdth,wght@75..112.5,400..600&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@600;700&family=M+PLUS+2:wght@450;500;700&family=Martian+Mono:wdth,wght@75..112.5,400..600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@600;700&family=M+PLUS+2:wght@450;500;700&family=Martian+Mono:wdth,wght@75..112.5,400..600&display=swap" rel="stylesheet">
  </noscript>

  <!-- TOMBO design system -->
  <link rel="stylesheet" href="/styles/tombo.css">
  <link rel="stylesheet" href="/styles/site.css">

  <style>
    .error-frame {
      max-width: 640px;
      margin: 0 auto;
      padding: 96px 0 120px;
      display: flex;
      flex-direction: column;
      gap: 40px;
    }

    .toggle-row {
      display: flex;
      justify-content: flex-end;
    }

    .error-panel {
      text-align: center;
    }

    .subtitle {
      text-align: center;
    }

    .error-log {
      text-align: left;
    }

    .log-line {
      display: block;
    }

    .log-line + .log-line {
      margin-top: 4px;
    }

    .prompt {
      color: var(--tombo-green);
    }

    .dim {
      color: var(--tombo-ink-faint);
    }

    .err-text {
      color: var(--tombo-error);
    }

    /* the caret is a shu rule, not a shu fill — matches index.astro's hero cursor */
    .cursor {
      display: inline-block;
      width: 2px;
      height: 1em;
      margin-left: 4px;
      vertical-align: middle;
      background: var(--tombo-shu);
    }

    .choice-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .quote-panel {
      max-width: 480px;
      text-align: left;
    }

    .quote-panel p {
      font-style: italic;
    }

    .quote-source {
      display: block;
      margin-top: 10px;
    }

    .exits {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .exit-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      min-width: 180px;
      text-align: center;
      text-decoration: none;
    }

    .exit-desc {
      font-size: var(--tombo-text-note);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 640px) {
      .error-frame {
        padding: 64px 0 80px;
        gap: 32px;
      }

      .exits {
        flex-direction: column;
        align-items: stretch;
      }

      .exit-link {
        min-width: 0;
      }
    }
  </style>
</head>
<body>
  <SkipLink />

  <main id="main-content" class="site-shell" role="main">
    <div class="error-frame">
      <div class="toggle-row">
        <ThemeToggle />
      </div>

      <div class="error-panel tombo-metric tombo-corners">
        <b class="tombo-corner-tr" aria-hidden="true"></b><b class="tombo-corner-bl" aria-hidden="true"></b>
        <p class="k">HTTP STATUS</p>
        <h1 class="v" aria-label="404 Error">404</h1>
        <span class="tombo-chip" data-status="err">NOT FOUND</span>
      </div>

      <p class="tombo-label subtitle">Page Not Found</p>

      <!-- Terminal -->
      <figure class="tombo-code error-log" role="region" aria-label="Error details">
        <figcaption><span>system — error.log</span><span>STDERR</span></figcaption>
        <pre><span class="log-line"><span class="prompt">&gt;</span> <span class="dim">Searching for</span> <span class="tombo-mono">requested_path</span><span class="dim">...</span></span><span class="log-line"><span class="err-text">ERROR:</span> No route matches this path.</span><span class="log-line"><span class="prompt">&gt;</span><span class="cursor" aria-hidden="true"></span></span></pre>
      </figure>

      <!-- Where to go instead -->
      <section class="choice-section" aria-labelledby="choice-heading">
        <h2 id="choice-heading" class="sr-only">Where to go from here</h2>

        <blockquote class="tombo-callout quote-panel">
          <p>Every page on this site was drawn against the same grid. This one was never drawn.</p>
          <cite class="tombo-label quote-source">— off the sheet</cite>
        </blockquote>

        <nav class="exits" aria-label="Navigation options">
          <a href="/" class="tombo-btn tombo-btn--primary exit-link" aria-label="Return to the homepage">
            <span class="exit-label">Index</span>
            <span class="exit-desc">Back to the front page</span>
          </a>

          <a href="/blog/" class="tombo-btn tombo-btn--secondary exit-link" aria-label="Browse the blog">
            <span class="exit-label">Blog</span>
            <span class="exit-desc">17 articles, all measured</span>
          </a>
        </nav>
      </section>
    </div>
  </main>

  <script is:inline src="/scripts/theme.js" defer></script>
</body>
</html>
