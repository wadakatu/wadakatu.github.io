---
/**
 * The choice between the two readings: one capsule, two halves. Each half is a real link to a
 * static route, so the choice works without JavaScript; the script only makes it happen in place.
 */
interface Props { page: 'home' | 'projects'; view?: 'page' | 'machine'; notes?: [string, string] }
const { page, view, notes } = Astro.props;
const root = '/proto/matrix/' + (page === 'projects' ? 'projects/' : '');
const halves = [
  { mode: 'page', label: '人間用', href: root },
  { mode: 'machine', label: '機械用', href: root + 'machine/' },
];
---
<span class:list={['pill', { 'pill--big': notes }]} role="group" aria-label="Reading">
  {halves.map((h, i) => (
    <a class="half" data-mode={h.mode} href={h.href} aria-current={h.mode === view ? 'true' : undefined}>
      <span lang="ja">{h.label}</span>{notes && <small>{notes[i]}</small>}
    </a>
  ))}
</span>
