---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SkipLink from '@components/SkipLink.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import Footer from '@components/Footer.astro';
import { profile, ratio } from '@/data/profile';

// derived at build time — the hero states numbers, so they have to be true
const posts = await getCollection('blog', ({ data }) => data.published === true);
const articleCount = posts.length;
const latestPost = posts
  .map((p) => p.data.published_at)
  .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())[0];
const latestDate = latestPost
  ? new Date(latestPost).toISOString().slice(0, 10)
  : '—';

// ruler tracks: each represents a round ceiling, so the fill reads as progress
// toward a milestone rather than as a fraction of nothing
const RULERS = {
  prs: ratio(profile.recentPrs, 40),
  repos: ratio(profile.originalRepos, 20),
  articles: ratio(articleCount, 20),
  years: ratio(new Date().getFullYear() - profile.since, 10),
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "@id": "https://www.wadakatu.dev/#person",
      "name": "wadakatu",
      "alternateName": "koyolympus",
      "jobTitle": "Backend Developer",
      "worksFor": {
        "@type": "Organization",
        "name": "Studio Inc."
      },
      "description": "Backend Developer @ Studio Inc. Building no-code website builders. Active OSS contributor to Laravel ecosystem. Creator of laravel-spectrum & gitlyte.",
      "url": "https://www.wadakatu.dev/",
      "image": "https://www.wadakatu.dev/images/logo-400.webp",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Osaka",
        "addressCountry": "JP"
      },
      "sameAs": [
        "https://github.com/wadakatu",
        "https://zenn.dev/wadakatu",
        "https://x.com/koyolympus"
      ],
      "knowsAbout": ["PHP", "Laravel", "Backend Development", "Open Source Software"]
    },
    "dateCreated": "2024-01-01",
    "dateModified": "2025-01-06"
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Featured Projects",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "SoftwareSourceCode",
          "name": "W3C Hackathon - TPAC 2025",
          "description": "Dashboard built with vibe-coding, guided by web-standards. Winner project.",
          "url": "https://github.com/wadakatu/w3c-hackathon",
          "author": { "@id": "https://www.wadakatu.dev/#person" }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "SoftwareSourceCode",
          "name": "Laravel Spectrum",
          "description": "Zero-annotation API documentation generator for Laravel.",
          "url": "https://docs.laravel-spectrum.dev",
          "author": { "@id": "https://www.wadakatu.dev/#person" },
          "programmingLanguage": "PHP"
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.wadakatu.dev/#website",
    "name": "wadakatu",
    "alternateName": "wadakatu.dev",
    "url": "https://www.wadakatu.dev/",
    "description": "Backend Developer @ Studio Inc. Building no-code website builders. Active OSS contributor to Laravel ecosystem.",
    "publisher": { "@id": "https://www.wadakatu.dev/#person" },
    "inLanguage": ["en", "ja"]
  }
];
---

<BaseLayout
  title="wadakatu | Backend Developer"
  description="Backend Developer @ Studio Inc. Building no-code website builders. Active OSS contributor to Laravel ecosystem. Creator of laravel-spectrum & gitlyte."
  ogUrl="https://www.wadakatu.dev/"
  canonicalUrl="https://www.wadakatu.dev/"
  jsonLd={jsonLd}
>
  <!-- Skip Link for Keyboard Navigation -->
  <SkipLink />

  <main id="main-content" class="page-main tombo-sections">
    <!-- Hero Section -->
    <header class="hero tombo-vol-lp tombo-glow tombo-corners" transition:name="hero">
      <b class="tombo-corner-tr" aria-hidden="true"></b><b class="tombo-corner-bl" aria-hidden="true"></b>
      <div class="tombo-shell">
        <div class="hero-top">
          <ThemeToggle />
        </div>
        <div class="hero-cols">
          <div>
            <p class="tombo-kicker">Hello, World!<span class="cursor"></span></p>
            <h1 class="tombo-display" transition:name="site-title">wadakatu<span class="highlight">_</span></h1>
            <div class="tombo-dim hero-dim" aria-hidden="true"></div>
            <div class="tombo-dimlab">handle: 1 line — measured / glyphs: 9</div>
            <p class="hero-role" transition:name="site-role">Backend Developer @ Studio Inc.</p>
            <div class="hero-meta">
              <span class="hero-location">Osaka, Japan</span>
              <nav class="social-links" aria-label="Social links">
                <a href="https://github.com/wadakatu" target="_blank" rel="noopener noreferrer" class="tombo-chip social-link" aria-label="GitHub">GITHUB</a>
                <a href="https://zenn.dev/wadakatu" target="_blank" rel="noopener noreferrer" class="tombo-chip social-link" aria-label="Zenn">ZENN</a>
                <a href="https://x.com/koyolympus" target="_blank" rel="noopener noreferrer" class="tombo-chip social-link" aria-label="X (Twitter)">X</a>
                <a href="mailto:wadakatu.dev@gmail.com" class="tombo-chip social-link" aria-label="Email">EMAIL</a>
              </nav>
            </div>
          </div>

          <figure class="hero-panel tombo-metric tombo-glow tombo-corners">
            <b class="tombo-corner-tr" aria-hidden="true"></b><b class="tombo-corner-bl" aria-hidden="true"></b>
            <p class="tombo-fig">FIG. 00 — ACTIVITY</p>
            <div class="k">Pull requests merged</div>
            <div class="v">{profile.recentPrs}<span class="unit">/ 12 MO</span></div>
            <div class="tombo-ruler" style={`--tombo-ruler-value:${(RULERS.prs * 100).toFixed(0)}%`} aria-hidden="true"></div>
            <dl class="hero-rows">
              <div class="hero-row"><dt>Original repos</dt><dd>{profile.originalRepos}</dd></div>
              <div class="hero-row"><dt>OSS forks</dt><dd>{profile.ossForks}</dd></div>
              <div class="hero-row"><dt>Articles published</dt><dd>{articleCount}</dd></div>
              <div class="hero-row"><dt>Latest entry</dt><dd class="is-now">{latestDate}</dd></div>
            </dl>
            <figcaption class="tombo-dimlab">github.com/wadakatu — verified {profile.verifiedOn}</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <!-- Navigation Hub -->
    <section class="nav-hub tombo-shell" aria-labelledby="nav-heading">
      <SectionHeader command="ls ./" srLabel="Site Navigation" id="nav-heading" />
      <div class="tombo-dim" aria-hidden="true"></div>
      <div class="tombo-dimlab">entries: 3 — measured</div>
      <nav class="nav-grid" aria-label="Main navigation">
        <a href="/projects" class="nav-card tombo-metric tombo-corners" transition:name="nav-projects">
          <p class="tombo-fig">FIG. 01 — PROJECTS</p>
          <p class="nav-value">{profile.originalRepos}<span class="unit">repos</span></p>
          <h3 class="nav-title">Projects</h3>
          <p class="nav-desc">OSS contributions & personal works</p>
          <div class="tombo-ruler" style={`--tombo-ruler-value:${(RULERS.repos * 100).toFixed(0)}%`} aria-hidden="true"></div>
          <p class="nav-foot">
            <span>{profile.ossForks} forks upstream</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </p>
        </a>
        <a href="/blog" class="nav-card tombo-metric tombo-corners" transition:name="nav-blog">
          <p class="tombo-fig">FIG. 02 — BLOG</p>
          <p class="nav-value">{articleCount}<span class="unit">articles</span></p>
          <h3 class="nav-title">Blog</h3>
          <p class="nav-desc">Tech articles & learnings</p>
          <div class="tombo-ruler" style={`--tombo-ruler-value:${(RULERS.articles * 100).toFixed(0)}%`} aria-hidden="true"></div>
          <p class="nav-foot">
            <span>latest {latestDate}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </p>
        </a>
        <a href="/about" class="nav-card tombo-metric tombo-corners" transition:name="nav-about">
          <p class="tombo-fig">FIG. 03 — ABOUT</p>
          <p class="nav-value">{profile.since}<span class="unit">since</span></p>
          <h3 class="nav-title">About</h3>
          <p class="nav-desc">Career & skills</p>
          <div class="tombo-ruler" style={`--tombo-ruler-value:${(RULERS.years * 100).toFixed(0)}%`} aria-hidden="true"></div>
          <p class="nav-foot">
            <span>{profile.skillCount} skills tracked</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </p>
        </a>
      </nav>
    </section>

    <!-- Featured Section -->
    <section class="featured tombo-shell" aria-labelledby="featured-heading">
      <SectionHeader command="cat featured.txt" srLabel="Featured Projects" id="featured-heading" />
      <div class="tombo-dim" aria-hidden="true"></div>
      <div class="tombo-dimlab">entries: 2 — measured</div>
      <div class="featured-grid">
        <a href="https://github.com/wadakatu/w3c-hackathon" target="_blank" rel="noopener noreferrer" class="featured-card tombo-metric tombo-corners">
          <p class="tombo-fig">FIG. 04 — WINNER</p>
          <span class="tombo-chip" data-status="ok">WINNER</span>
          <span class="tombo-label featured-type">Project</span>
          <h3 class="featured-title">W3C Hackathon - TPAC 2025</h3>
          <p class="featured-desc">Dashboard built with vibe-coding, guided by web-standards.</p>
          <div class="featured-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
        <a href="https://docs.laravel-spectrum.dev" target="_blank" rel="noopener noreferrer" class="featured-card tombo-metric tombo-corners">
          <p class="tombo-fig">FIG. 05 — OSS</p>
          <span class="tombo-label featured-type">OSS</span>
          <h3 class="featured-title">Laravel Spectrum</h3>
          <p class="featured-desc">Zero-annotation API documentation generator for Laravel.</p>
          <div class="featured-arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <div class="tombo-shell footer-wrap">
      <Footer />
    </div>
  </main>
</BaseLayout>

<style>
  /* ===== LAYOUT ===== */
  .page-main {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-main > * + * {
    margin-top: 64px;
  }

  .footer-wrap {
    margin-top: auto;
  }

  /* ===== HERO ===== */
  .hero {
    padding-block: 64px 56px;
  }

  /* full-bleed frame: the corners' 1px outdent would poke past the viewport
     and grow scrollWidth (see ~/tombo/examples/lp.html) */
  .hero.tombo-corners::after,
  .hero .tombo-corner-tr {
    right: 0;
  }

  .hero-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 24px;
  }

  .hero h1 {
    margin-top: 14px;
  }

  .hero h1 .highlight {
    color: var(--tombo-green);
  }

  /* the caret is a shu rule, not a shu fill — 掟 3 forbids filling the shape */
  .cursor {
    display: inline-block;
    width: 2px;
    height: 15px;
    margin-left: 6px;
    vertical-align: middle;
    background: var(--tombo-shu);
  }

  /* the instrument sits beside the wordmark instead of leaving the right two
     thirds of the first screen as empty graph paper */
  .hero-cols {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 56px;
    align-items: center;
  }

  .hero-panel {
    padding: 24px 26px;
    margin: 0;
  }

  .hero-panel .v {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .hero-rows {
    margin-top: 16px;
    border-top: 1px solid var(--tombo-hairline);
  }

  .hero-row {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-label);
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 8px 0;
    border-bottom: 1px solid var(--tombo-hairline);
    color: var(--tombo-ink-sub);
  }

  .hero-row dd {
    color: var(--tombo-ink);
    font-weight: 500;
  }

  .hero-row .is-now {
    color: var(--tombo-green);
  }

  .hero-panel figcaption {
    margin-top: 12px;
  }

  .hero-dim {
    width: 160px;
    margin-top: 20px;
  }

  .hero-role {
    margin-top: 18px;
    color: var(--tombo-ink-sub);
  }

  .hero-meta {
    margin-top: 26px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero-location {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-faint);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .social-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .social-link {
    text-decoration: none;
    color: var(--tombo-ink-sub);
    transition: color var(--tombo-dur) var(--tombo-ease), border-color var(--tombo-dur) var(--tombo-ease);
  }

  .social-link:hover {
    color: var(--tombo-ink);
    border-color: var(--tombo-ink-sub);
  }

  /* ===== NAVIGATION HUB ===== */
  .nav-grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  /* left-aligned, not centred: the card leads with a measured number and a ruler
     now, and a centred instrument reads as a poster rather than as a gauge */
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .nav-card:hover,
  .nav-card:focus-visible {
    border-color: var(--tombo-ink-sub);
    transform: translateY(-2px);
  }

  .nav-value {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-metric);
    line-height: var(--tombo-lh-metric);
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 2px;
  }

  .unit {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-note);
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--tombo-ink-faint);
  }

  .nav-title {
    margin-top: 4px;
  }

  .nav-desc {
    font-size: var(--tombo-text-ui);
    line-height: var(--tombo-lh-ui);
    color: var(--tombo-ink-sub);
  }

  .nav-card .tombo-ruler {
    margin-top: auto;
    height: 14px;
  }

  .nav-foot {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-label);
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--tombo-ink-faint);
  }

  .nav-foot svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .nav-card:hover .nav-foot svg {
    color: var(--tombo-green);
    transform: rotate(-45deg);
  }

  /* ===== FEATURED SECTION ===== */
  .featured-grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: border-color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .featured-card:hover,
  .featured-card:focus-visible {
    border-color: var(--tombo-ink-sub);
    transform: translateY(-2px);
  }

  .featured-type {
    margin-top: 10px;
  }

  .featured-title {
    margin-top: 6px;
  }

  .featured-desc {
    margin-top: 8px;
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-sub);
  }

  .featured-arrow {
    margin-top: auto;
    align-self: flex-end;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tombo-ink-faint);
    transition: color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .featured-card:hover .featured-arrow {
    color: var(--tombo-green);
    transform: rotate(-45deg);
  }

  .featured-arrow svg {
    width: 16px;
    height: 16px;
  }

  /* ===== RESPONSIVE ===== */
  /* the instrument's mono rows stop fitting beside the wordmark before the
     nav grid does, so the hero stacks at its own threshold, not a device's */
  @media (max-width: 980px) {
    .hero-cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 768px) {
    .nav-grid,
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .hero-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .page-main > * + * {
      margin-top: 40px;
    }
  }
</style>
