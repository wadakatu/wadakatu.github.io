---
import BaseLayout from '@layouts/BaseLayout.astro';
import SkipLink from '@components/SkipLink.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import Footer from '@components/Footer.astro';

const title = 'Projects';
const description = 'OSS contributions and personal projects by wadakatu - Laravel, TypeScript, and frontend experiments.';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://www.wadakatu.dev/projects/#page",
  "name": "Projects | wadakatu",
  "description": description,
  "url": "https://www.wadakatu.dev/projects/",
  "author": {
    "@id": "https://www.wadakatu.dev/#person"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.wadakatu.dev/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Projects"
      }
    ]
  }
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} bodyClass="tombo-gutters">
  <SkipLink />

  <div class="tombo-shell page-frame">
    <div class="page-header-row">
      <PageHeader title="Projects" />
      <ThemeToggle />
    </div>

    <main id="main-content" class="projects-content tombo-sections">
      <!-- Stats Bar -->
      <div class="stats-bar">
        <div class="stat-item tombo-metric">
          <div class="k">Repositories</div>
          <div class="v">10</div>
        </div>
        <div class="stat-item tombo-metric">
          <div class="k">Featured</div>
          <div class="v">3</div>
        </div>
        <div class="stat-item tombo-metric">
          <div class="k">Languages</div>
          <div class="v">5+</div>
        </div>
      </div>

      <!-- Featured Projects -->
      <section>
        <SectionHeader command="ls featured/" />
        <div class="tombo-dim" aria-hidden="true"></div>
        <div class="tombo-dimlab">3 items</div>

        <div class="featured-grid">
          <a href="https://github.com/wadakatu/laravel-spectrum" target="_blank" class="featured-card tombo-metric tombo-corners">
            <p class="tombo-fig">FIG. 01 — PHP</p>
            <div class="featured-header">
              <div class="featured-icon" aria-hidden="true">🌈</div>
              <div class="featured-meta">
                <span class="tombo-label featured-lang">PHP</span>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
            <h3 class="featured-name">laravel-spectrum<span class="highlight">_</span></h3>
            <p class="featured-desc">Zero-annotation API documentation generator for Laravel. Beautiful, automatic, always up-to-date.</p>
            <div class="featured-tags">
              <span class="tombo-chip">#laravel</span>
              <span class="tombo-chip">#api-docs</span>
              <span class="tombo-chip">#oss</span>
            </div>
          </a>

          <a href="https://github.com/wadakatu/screenbook" target="_blank" class="featured-card tombo-metric tombo-corners">
            <p class="tombo-fig">FIG. 02 — TYPESCRIPT</p>
            <div class="featured-header">
              <div class="featured-icon" aria-hidden="true">📖</div>
              <div class="featured-meta">
                <span class="tombo-label featured-lang">TypeScript</span>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
            <h3 class="featured-name">screenbook<span class="highlight">_</span></h3>
            <p class="featured-desc">Screen catalog & navigation graph generator. Define screens in code, get always-up-to-date documentation.</p>
            <div class="featured-tags">
              <span class="tombo-chip">#cli</span>
              <span class="tombo-chip">#documentation</span>
              <span class="tombo-chip">#frontend</span>
            </div>
          </a>

          <a href="https://github.com/wadakatu/gitlyte" target="_blank" class="featured-card tombo-metric tombo-corners">
            <p class="tombo-fig">FIG. 03 — TYPESCRIPT</p>
            <div class="featured-header">
              <div class="featured-icon" aria-hidden="true">⚡</div>
              <div class="featured-meta">
                <span class="tombo-label featured-lang">TypeScript</span>
                <svg class="featured-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
            <h3 class="featured-name">gitlyte<span class="highlight">_</span></h3>
            <p class="featured-desc">Instantly turn your GitHub repo into a live website with AI-powered design. No code needed.</p>
            <div class="featured-tags">
              <span class="tombo-chip">#ai</span>
              <span class="tombo-chip">#github</span>
              <span class="tombo-chip">#website-builder</span>
            </div>
          </a>
        </div>
      </section>

      <div class="tombo-dim" aria-hidden="true"></div>

      <!-- Other Projects -->
      <section>
        <SectionHeader command="ls projects/" />
        <div class="tombo-dim" aria-hidden="true"></div>
        <div class="tombo-dimlab">6 items</div>

        <table class="tombo-table other-table">
          <thead>
            <tr><th>Repository</th><th>Description</th><th>Lang</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><span aria-hidden="true">🏆</span> <a href="https://github.com/wadakatu/w3c-hackathon" target="_blank">w3c-hackathon</a></td>
              <td>Dashboard built with vibe-coding</td>
              <td class="tombo-mono">JS</td>
            </tr>
            <tr>
              <td><span aria-hidden="true">🔬</span> <a href="https://github.com/wadakatu/ui_lab" target="_blank">ui_lab</a></td>
              <td>Frontend UI Component Laboratory</td>
              <td class="tombo-mono">HTML</td>
            </tr>
            <tr>
              <td><span aria-hidden="true">🔧</span> <a href="https://github.com/wadakatu/laravel-factory-refactor" target="_blank">laravel-factory-refactor</a></td>
              <td>Refactor factory call style in Laravel 8.x~10.x</td>
              <td class="tombo-mono">PHP</td>
            </tr>
            <tr>
              <td><span aria-hidden="true">🎠</span> <a href="https://github.com/wadakatu/studio-carousel" target="_blank">studio-carousel</a></td>
              <td>Carousel collection for Studio UI lab</td>
              <td class="tombo-mono">CSS</td>
            </tr>
            <tr>
              <td><span aria-hidden="true">📊</span> <a href="https://github.com/wadakatu/slides" target="_blank">slides</a></td>
              <td>Presentation slides built with Slidev</td>
              <td class="tombo-mono">Vue</td>
            </tr>
            <tr>
              <td><span aria-hidden="true">📄</span> <a href="https://github.com/wadakatu/resume" target="_blank">resume</a></td>
              <td>Fake it until you make it</td>
              <td class="tombo-mono">CSS</td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Terminal Output -->
      <figure class="tombo-code terminal-output">
        <figcaption><span>SHELL — LOG</span><span>OUTPUT</span></figcaption>
        <pre><span class="term-line"><span class="prompt">$</span> git log --oneline -1</span><span class="term-line term-output"><span class="success">✓</span> All projects loaded successfully</span><span class="term-line"><span class="prompt">$</span> echo "More projects coming soon..."</span></pre>
      </figure>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /* ===== PROJECTS PAGE STYLES ===== */

  .page-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: 40px;
    padding-block: 40px 0;
  }

  .page-frame > footer {
    margin-top: auto;
  }

  .projects-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Stats Bar */
  .stats-bar {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  .stat-item {
    flex: 1 1 160px;
  }

  .stat-item .v {
    margin-top: 4px;
  }

  /* Featured Projects Grid */
  .featured-grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    transition: border-color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .featured-card:hover,
  .featured-card:focus-visible {
    border-color: var(--tombo-ink-sub);
    transform: translateY(-2px);
  }

  .featured-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 10px;
  }

  .featured-icon {
    font-size: var(--tombo-text-h2);
    line-height: 1;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .featured-arrow {
    width: 16px;
    height: 16px;
    color: var(--tombo-ink-faint);
    opacity: 0;
    transform: translateX(-8px);
    transition: all var(--tombo-dur) var(--tombo-ease);
  }

  .featured-card:hover .featured-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--tombo-green);
  }

  .featured-name {
    margin: 0;
  }

  .featured-name .highlight {
    color: var(--tombo-green);
  }

  .featured-desc {
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-sub);
    flex: 1;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  /* Other Projects Table */
  .other-table {
    margin-top: 20px;
  }

  /* the link fills the cell's padding box so the touch target matches the row,
     which an <a> cannot do by wrapping <tr> without breaking table semantics */
  .other-table td a {
    color: inherit;
    display: block;
    margin: -10px -14px;
    padding: 10px 14px;
  }

  /* Terminal Output */
  .terminal-output .term-line {
    display: block;
  }

  .terminal-output .term-output {
    padding-left: 1.5rem;
  }

  .terminal-output .prompt,
  .terminal-output .success {
    color: var(--tombo-code-green);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .stats-bar {
      flex-wrap: wrap;
    }
  }
</style>
