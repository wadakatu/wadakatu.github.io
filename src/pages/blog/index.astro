---
import BaseLayout from '@layouts/BaseLayout.astro';
import SkipLink from '@components/SkipLink.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionHeader from '@components/SectionHeader.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import Footer from '@components/Footer.astro';
import { getCollection } from 'astro:content';

const title = 'Blog';
const description = 'Tech articles and learnings by wadakatu - Laravel, TypeScript, and web development.';

// Get all published blog posts
const allPosts = await getCollection('blog', ({ data }) => data.published === true);
const posts = allPosts.sort((a, b) => {
  const dateA = a.data.published_at?.getTime() ?? 0;
  const dateB = b.data.published_at?.getTime() ?? 0;
  return dateB - dateA;
});

// Category helpers
function getCategory(type: string) {
  return type === 'tech' ? 'Tech' : 'Life';
}

function formatDate(date: Date | undefined) {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function calculateReadingTime(body: string) {
  const text = body.replace(/```[\s\S]*?```/g, '').replace(/`[^`]+`/g, '');
  return Math.max(1, Math.ceil(text.length / 500));
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://www.wadakatu.dev/blog/#page",
    "name": "Blog | wadakatu",
    "description": description,
    "url": "https://www.wadakatu.dev/blog/",
    "author": {
      "@id": "https://www.wadakatu.dev/#person"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.wadakatu.dev/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} lang="ja" jsonLd={jsonLd} bodyClass="tombo-gutters">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="wadakatu Blog RSS Feed" href="https://www.wadakatu.dev/feed.xml">
    <link rel="alternate" type="application/atom+xml" title="wadakatu Blog Atom Feed" href="https://www.wadakatu.dev/atom.xml">
  </Fragment>

  <SkipLink />

  <div class="tombo-shell page-frame">
    <div class="page-header-row">
      <PageHeader title="Blog" />
      <ThemeToggle />
    </div>

    <main id="main-content" class="blog-content tombo-sections">
      <!-- Stats Header -->
      <div class="blog-stats">
        <div class="stats-info">
          <span class="stats-count tombo-mono" id="article-count">{posts.length} articles</span>
          <span class="stats-label">Published on Zenn</span>
        </div>
        <a href="https://zenn.dev/wadakatu" target="_blank" class="zenn-badge">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z"/>
          </svg>
          Zenn Profile
        </a>
        <a href="/feed.xml" class="zenn-badge" title="Subscribe via RSS">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
          </svg>
          RSS
        </a>
      </div>

      <!-- Category Tabs -->
      <section class="category-section">
        <SectionHeader command="ls ./categories" />
        <div class="tombo-dim" aria-hidden="true"></div>
        <div class="category-tabs">
          <button type="button" class="category-tab" data-category="All" aria-pressed="true">All</button>
          <button type="button" class="category-tab" data-category="Tech" aria-pressed="false">Tech</button>
          <button type="button" class="category-tab" data-category="Life" aria-pressed="false">Life</button>
        </div>
      </section>

      <!-- Articles List -->
      <ul class="tombo-ticks articles-list" id="articles-container">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id.replace(/\.md$/, '')}/`} class="article-card" data-category={getCategory(post.data.type)}>
              <span class="article-emoji" aria-hidden="true">{post.data.emoji}</span>
              <div class="article-content">
                <h3 class="article-title">{post.data.title}</h3>
                <div class="article-meta">
                  <span class="article-category">{getCategory(post.data.type)}</span>
                  <span class="article-separator" aria-hidden="true">•</span>
                  <span class="article-date tombo-mono">{formatDate(post.data.published_at)}</span>
                  <span class="article-separator" aria-hidden="true">•</span>
                  <span class="article-reading-time tombo-mono">{calculateReadingTime(post.body ?? '')} min</span>
                </div>
                <div class="article-topics tombo-mono">
                  {post.data.topics.slice(0, 3).map((topic) => `#${topic}`).join(' ')}
                </div>
              </div>
              <svg class="article-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
        {posts.length === 0 && (
          <li class="no-articles">No articles found</li>
        )}
      </ul>
    </main>

    <Footer />
  </div>

  <Fragment slot="scripts">
    <script is:inline>
      // Category filtering
      document.querySelectorAll('.category-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          const category = tab.dataset.category;
          const container = document.getElementById('articles-container');
          const countEl = document.getElementById('article-count');

          // Update pressed state
          document.querySelectorAll('.category-tab').forEach(t => t.setAttribute('aria-pressed', 'false'));
          tab.setAttribute('aria-pressed', 'true');

          // Filter articles (hide the <li> row, not just the card, so the
          // tombo-ticks tick mark doesn't linger on a filtered-out row)
          const rows = container.querySelectorAll(':scope > li');
          let visibleCount = 0;

          rows.forEach(row => {
            const card = row.querySelector('.article-card');
            if (!card) return;
            if (category === 'All' || card.dataset.category === category) {
              row.style.display = '';
              visibleCount++;
            } else {
              row.style.display = 'none';
            }
          });

          // Update count
          countEl.textContent = visibleCount + ' articles';
        });
      });
    </script>
  </Fragment>
</BaseLayout>

<style>
  /* ===== BLOG PAGE STYLES ===== */

  .page-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: 40px;
    padding-block: 40px 0;
  }

  .page-frame > footer {
    margin-top: auto;
  }

  .blog-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Stats Header */
  .blog-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .stats-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stats-count {
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink);
  }

  .stats-label {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-label);
    color: var(--tombo-ink-faint);
  }

  .zenn-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-label);
    color: var(--tombo-ink-faint);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--tombo-hairline);
    transition: color var(--tombo-dur) var(--tombo-ease), border-color var(--tombo-dur) var(--tombo-ease);
  }

  .zenn-badge:hover {
    color: var(--tombo-ink);
    border-color: var(--tombo-ink-sub);
  }

  .zenn-badge svg {
    width: 14px;
    height: 14px;
  }

  /* Category Tabs */
  .category-tabs {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .category-tab {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-ui);
    padding: 8px 18px;
    border: 1px solid var(--tombo-hairline);
    background: none;
    color: var(--tombo-ink-sub);
    cursor: pointer;
    transition: border-color var(--tombo-dur) var(--tombo-ease), color var(--tombo-dur) var(--tombo-ease);
  }

  .category-tab:hover {
    border-color: var(--tombo-ink-sub);
    color: var(--tombo-ink);
  }

  .category-tab[aria-pressed="true"] {
    border-color: var(--tombo-ink);
    color: var(--tombo-ink);
    font-weight: 500;
  }

  /* Articles List */
  .articles-list {
    margin-top: 4px;
  }

  .articles-list > li {
    border-bottom: 1px solid var(--tombo-hairline);
  }

  .articles-list > li:last-child {
    border-bottom: none;
  }

  /* Article Card */
  .article-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    text-decoration: none;
    color: inherit;
  }

  .article-emoji {
    font-size: var(--tombo-text-h2);
    line-height: 1;
    flex-shrink: 0;
  }

  .article-content {
    flex: 1;
    min-width: 0;
  }

  .article-title {
    transition: color var(--tombo-dur) var(--tombo-ease);
  }

  .article-card:hover .article-title,
  .article-card:focus-visible .article-title {
    color: var(--tombo-green);
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .article-category {
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-sub);
  }

  .article-date,
  .article-reading-time {
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-faint);
  }

  .article-separator {
    color: var(--tombo-ink-faint);
  }

  .article-topics {
    margin-top: 6px;
    font-size: var(--tombo-text-label);
    color: var(--tombo-ink-faint);
  }

  .article-arrow {
    width: 20px;
    height: 20px;
    color: var(--tombo-ink-faint);
    flex-shrink: 0;
    transition: color var(--tombo-dur) var(--tombo-ease), transform var(--tombo-dur) var(--tombo-ease);
  }

  .article-card:hover .article-arrow {
    color: var(--tombo-green);
    transform: translateX(4px);
  }

  /* No Articles */
  .no-articles {
    padding: 48px 0;
    text-align: center;
    font-family: var(--tombo-font-mono);
    font-size: var(--tombo-text-ui);
    color: var(--tombo-ink-faint);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .blog-stats {
      flex-direction: column;
      align-items: flex-start;
    }

    .article-card {
      flex-wrap: wrap;
    }

    .article-arrow {
      display: none;
    }
  }
</style>
