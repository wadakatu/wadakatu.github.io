---
import BaseLayout from '@layouts/BaseLayout.astro';
import SkipLink from '@components/SkipLink.astro';
import PageHeader from '@components/PageHeader.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import Footer from '@components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published === true);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Helpers
function getCategory(type: string) {
  return type === 'tech' ? 'Tech' : 'Life';
}

function formatDate(date: Date | undefined) {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function calculateReadingTime(body: string) {
  const text = body.replace(/```[\s\S]*?```/g, '').replace(/`[^`]+`/g, '');
  return Math.max(1, Math.ceil(text.length / 500));
}

const category = getCategory(post.data.type);
const readingTime = calculateReadingTime(post.body ?? '');
const slug = post.id.replace(/\.md$/, '');

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `https://www.wadakatu.dev/blog/${slug}/#article`,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://www.wadakatu.dev/blog/${slug}/`
    },
    "headline": post.data.title,
    "description": post.data.title,
    "datePublished": post.data.published_at?.toISOString(),
    "dateModified": post.data.updated_at?.toISOString() ?? post.data.published_at?.toISOString(),
    "author": {
      "@type": "Person",
      "@id": "https://www.wadakatu.dev/#person",
      "name": "wadakatu",
      "url": "https://www.wadakatu.dev/"
    },
    "publisher": {
      "@type": "Person",
      "@id": "https://www.wadakatu.dev/#person"
    },
    "keywords": post.data.topics.join(', ')
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.wadakatu.dev/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://www.wadakatu.dev/blog/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": post.data.title
      }
    ]
  }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.title}
  ogType="article"
  lang="ja"
  jsonLd={jsonLd}
  bodyClass="tombo-gutters"
>
  <SkipLink />

  <div class="tombo-shell page-frame">
    <div class="page-header-row">
      <PageHeader backLink="/blog/" backLabel="cd ../blog" />
      <ThemeToggle />
    </div>

    <main class="article-container" id="main-content">
      <header class="article-header">
        <p class="tombo-fig">BLOG — {category.toUpperCase()}</p>
        <div class="article-title-row">
          <span class="article-emoji" aria-hidden="true">{post.data.emoji}</span>
          <h1 class="article-title">{post.data.title}</h1>
        </div>
        <div class="article-meta">
          <span class="tombo-label">{category}</span>
          <span class="article-date tombo-mono">{formatDate(post.data.published_at)}</span>
          <span class="article-reading-time tombo-mono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            {readingTime} min read
          </span>
        </div>
        <div class="article-topics">
          {post.data.topics.map((topic) => (
            <span class="tombo-chip">#{topic}</span>
          ))}
        </div>
      </header>

      <div class="tombo-dim" aria-hidden="true"></div>

      <div class="article-layout">
        <aside class="toc-rail" id="toc-rail"></aside>
        <div class="article-content">
          <div class="markdown-body">
            <Content />
          </div>
        </div>
      </div>

      <div class="tombo-dim" aria-hidden="true"></div>

      <footer class="article-footer">
        <nav class="article-footer-nav">
          <a href="/blog/" class="tombo-btn tombo-btn--secondary nav-button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Back to Blog
          </a>
        </nav>
      </footer>
    </main>

    <Footer />
  </div>

  <Fragment slot="scripts">
    <script is:inline src="/scripts/code-copy.js"></script>
    <script is:inline src="/scripts/toc.js"></script>
  </Fragment>
</BaseLayout>

<style>
  /* ===== ARTICLE PAGE STYLES ===== */

  .page-frame {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    gap: 40px;
    padding-block: 40px 0;
  }

  .page-frame > footer {
    margin-top: auto;
  }

  .article-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ===== ARTICLE HEADER ===== */
  .article-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .article-title-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .article-emoji {
    font-size: var(--tombo-text-h1);
    line-height: 1;
    flex-shrink: 0;
  }

  .article-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .article-reading-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .article-reading-time svg {
    width: 14px;
    height: 14px;
    color: var(--tombo-green);
  }

  .article-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ===== ARTICLE LAYOUT (content + TOC rail) ===== */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  /* toc.js only inserts a .tombo-toc nav when the article has >= 2 headings;
     the rail otherwise stays empty and the grid collapses to one column */
  .article-layout:has(.tombo-toc) {
    grid-template-columns: 1fr 200px;
    gap: 56px;
  }

  /* the rail precedes the article in source order so it reads as a table of
     contents on narrow screens and to assistive tech; explicit placement puts
     it back on the right once there is room for a second column */
  .article-layout:has(.tombo-toc) > .article-content { grid-area: 1 / 1; }
  .article-layout:has(.tombo-toc) > .toc-rail { grid-area: 1 / 2; }

  /* grid items default to min-width:auto, so a single long unbroken token
     anywhere in the article (a bare URL, a long shell command in a code
     block) would otherwise force the whole track — and everything else in
     it — wider than the viewport at narrow widths */
  .article-content,
  .toc-rail {
    min-width: 0;
  }

  .toc-rail {
    position: sticky;
    top: 40px;
  }

  @media (max-width: 900px) {
    .article-layout:has(.tombo-toc) {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .article-layout:has(.tombo-toc) > .article-content,
    .article-layout:has(.tombo-toc) > .toc-rail { grid-area: auto; }

    .toc-rail {
      position: static;
      border-bottom: 1px solid var(--tombo-hairline);
      padding-bottom: 16px;
    }
  }

  /* ===== ARTICLE FOOTER ===== */
  .nav-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav-button svg {
    width: 16px;
    height: 16px;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .article-emoji {
      font-size: var(--tombo-text-h2);
    }
  }
</style>
