---
import FooterLogo from './FooterLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  showStatus?: boolean;
  showJstClock?: boolean;
  transitionName?: string;
}

const {
  showStatus = true,
  showJstClock = true,
  transitionName = 'footer',
} = Astro.props;
---

<footer class="footer tombo-footer" transition:name={transitionName}>
  <div class="footer-brand-group">
    <span class="tombo-logo" aria-hidden="true"><i class="h"></i><i class="b"></i><i class="w1"></i><i class="w2"></i><i class="t"></i></span>
    <FooterLogo />
  </div>
  {(showStatus || showJstClock) && (
    <div class="footer-status">
      {showStatus && (
        <span class="tombo-chip" data-status="ok">ONLINE</span>
      )}
      {showJstClock && (
        <span class="footer-time" id="jst-time">--:--:-- JST</span>
      )}
    </div>
  )}
  <ThemeToggle />
</footer>

{showJstClock && (
  <script is:inline>
    (() => {
      const tick = () => {
        const el = document.getElementById('jst-time');
        if (!el) return;
        el.textContent = new Date().toLocaleTimeString('en-US', {
          timeZone: 'Asia/Tokyo', hour12: false,
          hour: '2-digit', minute: '2-digit', second: '2-digit',
        }) + ' JST';
      };
      let timer = null;
      const start = () => { tick(); timer ??= setInterval(tick, 1000); };
      const stop = () => { clearInterval(timer); timer = null; };
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
      document.addEventListener('astro:after-swap', start);
      start();
    })();
  </script>
)}

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-brand-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  @media (max-width: 768px) {
    .footer {
      justify-content: center;
      text-align: center;
    }

    .footer-status {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
