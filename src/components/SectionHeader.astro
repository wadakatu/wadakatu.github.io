---
interface Props {
  command: string;
  srLabel?: string;
  id?: string;
}

const {
  command,
  srLabel,
  id,
} = Astro.props;
---

<!--
  Numbering ("01 — ") is generated by tombo.css's counter on `.tombo-sec`.
  It only counts up when an ancestor (typically the page's <main>) carries
  `class="tombo-sections"` — see tombo.css `.tombo-sections` / `.tombo-sec`
  (S-04) and ~/tombo/examples/components.html §05 for the live demo.
  Pages that render SectionHeader must opt in with that container class.
-->
<h2 class="tombo-sec" id={id}>
  {command}
  {srLabel && <span class="sr-only"> - {srLabel}</span>}
</h2>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
