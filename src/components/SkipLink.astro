---
interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'main-content', label = 'Skip to main content' } = Astro.props;
---

<a href={`#${targetId}`} class="skip-link tombo-btn tombo-btn--primary">{label}</a>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10000;
    text-decoration: none;
    transition: top var(--tombo-dur) var(--tombo-ease);
  }

  .skip-link:focus-visible {
    top: 0;
  }
</style>
